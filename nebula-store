/* ================= ALMACENAMIENTO ================= */
function leer(k, def){ try{ const v = localStorage.getItem(k); return v ? JSON.parse(v) : def; }catch(e){ return def; } }
function guardar(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
let usuarios = leer("nebula_usuarios", null);
if(!usuarios){
  usuarios = { "demo@nebula.com": { nombre:"Usuario Demo", correo:"demo@nebula.com", clave:"Demo1234", seguridad:"firulais",
    avatar:"🧑‍🚀", telefono:"", nacimiento:"", genero:"", bio:"", desde:"2026-01-15", intentos:0, bloqueado:false,
    config:{oscuro:false, notifCorreo:true, notifPedidos:true, fuente:"normal", idioma:"es"},
    favoritos:[1,13], carrito:[], pedidos:[
      {num:5001, fecha:"2026-09-20", items:[{id:9,cant:2}], total:142000, estado:"Entregado"},
      {num:5002, fecha:"2026-10-10", items:[{id:5,cant:1},{id:13,cant:1}], total:160000, estado:"Enviado"}
    ] } };
  guardar("nebula_usuarios", usuarios);
}
let actual = null, descuento = 0, cuponActivo = "", categoriaSel = "Todas";
const U = () => usuarios[actual];
const persistir = () => guardar("nebula_usuarios", usuarios);

/* ================= UTILIDADES ================= */
function alerta(id, txt, tipo){ const e = document.getElementById(id); e.textContent = txt; e.className = "alerta " + tipo; }
function limpiarAlerta(id){ document.getElementById(id).className = "alerta"; }
function toast(txt){ const t = document.getElementById("toast"); t.textContent = txt; t.classList.add("visible"); clearTimeout(t._t); t._t = setTimeout(() => t.classList.remove("visible"), 2600); }
const correoValido = c => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(c);
const claveValida = c => c.length >= 8 && /[A-Z]/.test(c) && /\d/.test(c);
function verClave(id){ const i = document.getElementById(id); i.type = i.type === "password" ? "text" : "password"; }
function abrirModal(id){ document.getElementById(id).classList.add("abierto"); }
function cerrarModal(id){ document.getElementById(id).classList.remove("abierto"); }

/* ================= AUTENTICACIÓN ================= */
function pestana(cual){
  ["login","registro","recuperar"].forEach(f => document.getElementById("form-" + f).classList.toggle("oculto", f !== cual));
  document.getElementById("tab-login").classList.toggle("activa", cual === "login");
  document.getElementById("tab-registro").classList.toggle("activa", cual === "registro");
  ["alerta-login","alerta-registro","alerta-recuperar"].forEach(limpiarAlerta);
}
function medirClave(){
  const c = document.getElementById("reg-clave").value;
  let p = 0; if(c.length >= 8) p++; if(/[A-Z]/.test(c)) p++; if(/\d/.test(c)) p++; if(/[^A-Za-z0-9]/.test(c)) p++;
  const niveles = [["0%","var(--borde)","Usa 8+ caracteres, una mayúscula y un número."],["25%","var(--err)","Muy débil"],["50%","var(--warn)","Débil"],["75%","#3b82f6","Buena"],["100%","var(--ok)","Fuerte 💪"]];
  const b = document.getElementById("medidor-barra"); b.style.width = niveles[p][0]; b.style.background = niveles[p][1];
  document.getElementById("medidor-texto").textContent = niveles[p][2];
}
function registrar(e){
  e.preventDefault();
  const nombre = document.getElementById("reg-nombre").value.trim();
  const correo = document.getElementById("reg-correo").value.trim().toLowerCase();
  const clave = document.getElementById("reg-clave").value;
  const conf = document.getElementById("reg-confirmar").value;
  const seg = document.getElementById("reg-pregunta").value.trim().toLowerCase();
  const term = document.getElementById("reg-terminos").checked;
  if(!nombre || !correo || !clave || !conf || !seg) return alerta("alerta-registro","Todos los campos son obligatorios.","error"), false;
  if(nombre.length < 3 || !/^[a-zA-ZáéíóúÁÉÍÓÚñÑ ]+$/.test(nombre)) return alerta("alerta-registro","El nombre debe tener al menos 3 letras y no contener números.","error"), false;
  if(!correoValido(correo)) return alerta("alerta-registro","El formato del correo no es válido.","error"), false;
  if(usuarios[correo]) return alerta("alerta-registro","Ya existe una cuenta con ese correo.","error"), false;
  if(!claveValida(clave)) return alerta("alerta-registro","La contraseña debe tener mínimo 8 caracteres, una mayúscula y un número.","error"), false;
  if(clave !== conf) return alerta("alerta-registro","Las contraseñas no coinciden.","error"), false;
  if(!term) return alerta("alerta-registro","Debes aceptar los términos y condiciones.","error"), false;
  usuarios[correo] = { nombre, correo, clave, seguridad:seg, avatar:"🧑‍🚀", telefono:"", nacimiento:"", genero:"", bio:"",
    desde:new Date().toISOString().slice(0,10), intentos:0, bloqueado:false,
    config:{oscuro:false, notifCorreo:true, notifPedidos:true, fuente:"normal", idioma:"es"}, favoritos:[], carrito:[], pedidos:[] };
  persistir();
  document.getElementById("form-registro").reset(); medirClave();
  pestana("login");
  document.getElementById("login-correo").value = correo;
  alerta("alerta-login","¡Cuenta creada con éxito! Ahora inicia sesión.","exito");
  return false;
}
function iniciarSesion(e){
  e.preventDefault();
  const correo = document.getElementById("login-correo").value.trim().toLowerCase();
  const clave = document.getElementById("login-clave").value;
  if(!correo || !clave) return alerta("alerta-login","Ingresa tu correo y contraseña.","error"), false;
  if(!correoValido(correo)) return alerta("alerta-login","El formato del correo no es válido.","error"), false;
  const u = usuarios[correo];
  if(!u) return alerta("alerta-login","No existe una cuenta con ese correo.","error"), false;
  if(u.bloqueado) return alerta("alerta-login","Cuenta bloqueada por 3 intentos fallidos. Recupera tu contraseña.","error"), false;
  if(u.clave !== clave){
    u.intentos++; if(u.intentos >= 3) u.bloqueado = true; persistir();
    return alerta("alerta-login", u.bloqueado ? "Cuenta bloqueada por 3 intentos fallidos. Recupera tu contraseña." : `Contraseña incorrecta. Te quedan ${3 - u.intentos} intento(s).`, "error"), false;
  }
  u.intentos = 0; persistir();
  if(document.getElementById("login-recordar").checked) guardar("nebula_sesion", correo); else guardar("nebula_sesion", null);
  entrar(correo);
  return false;
}
function recuperar(e){
  e.preventDefault();
  const correo = document.getElementById("rec-correo").value.trim().toLowerCase();
  const resp = document.getElementById("rec-respuesta").value.trim().toLowerCase();
  const nueva = document.getElementById("rec-nueva").value;
  if(!correo || !resp || !nueva) return alerta("alerta-recuperar","Completa todos los campos.","error"), false;
  const u = usuarios[correo];
  if(!u) return alerta("alerta-recuperar","No existe una cuenta con ese correo.","error"), false;
  if(u.seguridad !== resp) return alerta("alerta-recuperar","La respuesta de seguridad es incorrecta.","error"), false;
  if(!claveValida(nueva)) return alerta("alerta-recuperar","La nueva contraseña debe tener 8+ caracteres, una mayúscula y un número.","error"), false;
  u.clave = nueva; u.intentos = 0; u.bloqueado = false; persistir();
  document.getElementById("form-recuperar").reset();
  pestana("login"); document.getElementById("login-correo").value = correo;
  alerta("alerta-login","Contraseña restablecida. Ya puedes iniciar sesión.","exito");
  return false;
}
function entrar(correo){
  actual = correo; descuento = 0; cuponActivo = "";
  document.getElementById("vista-auth").classList.add("oculto");
  document.getElementById("vista-app").classList.remove("oculto");
  document.getElementById("form-login").reset();
  aplicarConfigGuardada(); refrescarUsuario(); ir("inicio");
  toast("¡Sesión iniciada! Bienvenido, " + U().nombre.split(" ")[0]);
}
function cerrarSesion(){
  actual = null; guardar("nebula_sesion", null);
  document.body.className = "";
  document.getElementById("vista-app").classList.add("oculto");
  document.getElementById("vista-auth").classList.remove("oculto");
  pestana("login"); alerta("alerta-login","Cerraste sesión correctamente.","exito");
}

/* ================= NAVEGACIÓN ================= */
const TITULOS = {inicio:"Inicio", buscar:"Buscar productos", favoritos:"Mis favoritos", carrito:"Carrito de compras", pedidos:"Mis pedidos", perfil:"Mi perfil", config:"Configuración"};
function ir(p){
  document.querySelectorAll(".pagina").forEach(x => x.classList.remove("activa"));
  document.querySelectorAll("aside .menu").forEach(x => x.classList.remove("activa"));
  document.getElementById("pag-" + p).classList.add("activa");
  document.getElementById("menu-" + p).classList.add("activa");
  document.getElementById("titulo-pagina").textContent = TITULOS[p];
  ({inicio:renderInicio, buscar:buscar, favoritos:renderFavoritos, carrito:renderCarrito, pedidos:renderPedidos, perfil:renderPerfil, config:renderConfig})[p]();
}
function refrescarUsuario(){
  const u = U();
  document.getElementById("chip-avatar").textContent = u.avatar;
  document.getElementById("chip-nombre").textContent = u.nombre;
  document.getElementById("insignia-fav").textContent = u.favoritos.length;
  document.getElementById("insignia-carrito").textContent = u.carrito.reduce((a,i) => a + i.cant, 0);
}

/* ================= PRODUCTOS ================= */
function tarjeta(p, prefijo){
  const fav = U().favoritos.includes(p.id);
  return `<div class="producto" id="${prefijo}-producto-${p.id}">
    <div class="img" style="background:${p.color}">${p.emoji}
      <button class="fav" id="${prefijo}-fav-${p.id}" title="Favorito" onclick="alternarFav(${p.id})">${fav ? "❤️" : "🤍"}</button></div>
    <div class="cuerpo">
      <h4 id="${prefijo}-nombre-${p.id}">${p.nombre}</h4>
      <div class="meta">${p.cat} · ⭐ ${p.rating}</div>
      <div class="precio" id="${prefijo}-precio-${p.id}">${fmt(p.precio)}</div>
      ${p.stock === 0 ? '<span class="agotado">Agotado</span>' : `<span class="meta">${p.stock} disponibles</span>`}
      <div class="acciones">
        <button class="btn-sec" id="${prefijo}-ver-${p.id}" onclick="verProducto(${p.id})">Ver</button>
        <button class="btn" id="${prefijo}-agregar-${p.id}" onclick="agregarCarrito(${p.id},1)" ${p.stock === 0 ? "disabled" : ""}>Agregar</button>
      </div>
    </div></div>`;
}
function alternarFav(id){
  const f = U().favoritos, i = f.indexOf(id);
  if(i >= 0){ f.splice(i,1); toast("Eliminado de favoritos"); } else { f.push(id); toast("Agregado a favoritos ❤️"); }
  persistir(); refrescarUsuario(); refrescarVista();
}
function refrescarVista(){ const a = document.querySelector(".pagina.activa").id.replace("pag-",""); ({inicio:renderInicio, buscar:buscar, favoritos:renderFavoritos})[a]?.(); }
function agregarCarrito(id, cant){
  const p = PRODUCTOS.find(x => x.id === id);
  const item = U().carrito.find(i => i.id === id);
  const enCarrito = item ? item.cant : 0;
  if(p.stock === 0){ toast("Producto agotado"); return false; }
  if(enCarrito + cant > p.stock){ toast(`Solo hay ${p.stock} unidades disponibles`); return false; }
  if(item) item.cant += cant; else U().carrito.push({id, cant});
  persistir(); refrescarUsuario(); toast(`🛒 ${p.nombre} agregado al carrito`);
  if(document.getElementById("pag-inicio").classList.contains("activa")) renderInicio();
  return true;
}
function verProducto(id){
  const p = PRODUCTOS.find(x => x.id === id);
  document.getElementById("modal-img").textContent = p.emoji;
  document.getElementById("modal-img").style.background = p.color;
  document.getElementById("modal-nombre").textContent = p.nombre;
  document.getElementById("modal-meta").textContent = `${p.cat} · ⭐ ${p.rating} · ${p.stock === 0 ? "Agotado" : p.stock + " disponibles"}`;
  document.getElementById("modal-descripcion").textContent = p.desc;
  document.getElementById("modal-precio").textContent = fmt(p.precio);
  document.getElementById("modal-cantidad").value = 1;
  document.getElementById("modal-cantidad").max = p.stock;
  limpiarAlerta("alerta-modal");
  const b = document.getElementById("modal-agregar"); b.disabled = p.stock === 0;
  b.onclick = () => {
    const c = parseInt(document.getElementById("modal-cantidad").value);
    if(isNaN(c) || c < 1) return alerta("alerta-modal","La cantidad debe ser mayor a 0.","error");
    if(agregarCarrito(id, c)) cerrarModal("modal-producto");
    else alerta("alerta-modal",`No puedes agregar más de ${p.stock} unidades.`,"error");
  };
  abrirModal("modal-producto");
}

/* ================= INICIO ================= */
function renderInicio(){
  const u = U();
  const saludos = {es:"¡Hola", en:"Hello", pt:"Olá"};
  document.getElementById("saludo").textContent = `${saludos[u.config.idioma]}, ${u.nombre.split(" ")[0]}! ${u.avatar}`;
  document.getElementById("stat-pedidos").textContent = u.pedidos.length;
  document.getElementById("stat-favoritos").textContent = u.favoritos.length;
  document.getElementById("stat-carrito").textContent = u.carrito.reduce((a,i) => a + i.cant, 0);
  document.getElementById("stat-gastado").textContent = fmt(u.pedidos.filter(p => p.estado !== "Cancelado").reduce((a,p) => a + p.total, 0));
  document.getElementById("rejilla-recomendados").innerHTML = [...PRODUCTOS].sort((a,b) => b.rating - a.rating).slice(0,4).map(p => tarjeta(p,"rec")).join("");
}

/* ================= BUSCAR ================= */
function pintarChips(){
  document.getElementById("chips-categorias").innerHTML = CATEGORIAS.map(c =>
    `<button class="chip ${c === categoriaSel ? "activa" : ""}" id="chip-${c.normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase()}" onclick="categoriaSel='${c}';buscar()">${c}</button>`).join("");
}
function buscar(){
  pintarChips(); limpiarAlerta("alerta-buscar");
  const q = document.getElementById("buscar-texto").value.trim().toLowerCase();
  const min = document.getElementById("filtro-min").value, max = document.getElementById("filtro-max").value;
  const orden = document.getElementById("filtro-orden").value;
  const rmin = parseFloat(document.getElementById("filtro-rating").value);
  const stock = document.getElementById("filtro-stock").checked;
  if((min && min < 0) || (max && max < 0)) { alerta("alerta-buscar","Los precios no pueden ser negativos.","error"); return; }
  if(min && max && Number(min) > Number(max)) { alerta("alerta-buscar","El precio mínimo no puede ser mayor que el máximo.","error"); return; }
  let r = PRODUCTOS.filter(p =>
    (categoriaSel === "Todas" || p.cat === categoriaSel) &&
    (!q || p.nombre.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q)) &&
    (!min || p.precio >= Number(min)) && (!max || p.precio <= Number(max)) &&
    p.rating >= rmin && (!stock || p.stock > 0));
  if(orden === "precio-asc") r.sort((a,b) => a.precio - b.precio);
  if(orden === "precio-desc") r.sort((a,b) => b.precio - a.precio);
  if(orden === "nombre") r.sort((a,b) => a.nombre.localeCompare(b.nombre));
  if(orden === "rating") r.sort((a,b) => b.rating - a.rating);
  document.getElementById("rejilla-resultados").innerHTML = r.map(p => tarjeta(p,"res")).join("");
  document.getElementById("contador-resultados").textContent = `${r.length} producto(s) encontrado(s)`;
  document.getElementById("sin-resultados").classList.toggle("oculto", r.length > 0);
}
function limpiarFiltros(){
  ["buscar-texto","filtro-min","filtro-max"].forEach(id => document.getElementById(id).value = "");
  document.getElementById("filtro-orden").value = "relevancia";
  document.getElementById("filtro-rating").value = "0";
  document.getElementById("filtro-stock").checked = false;
  categoriaSel = "Todas"; buscar();
}

/* ================= FAVORITOS ================= */
function renderFavoritos(){
  const l = PRODUCTOS.filter(p => U().favoritos.includes(p.id));
  document.getElementById("rejilla-favoritos").innerHTML = l.map(p => tarjeta(p,"fav")).join("");
  document.getElementById("favoritos-vacio").classList.toggle("oculto", l.length > 0);
}

/* ================= CARRITO ================= */
function totales(){
  const sub = U().carrito.reduce((a,i) => a + PRODUCTOS.find(p => p.id === i.id).precio * i.cant, 0);
  const desc = sub * descuento, base = sub - desc;
  const envio = sub === 0 || base >= ENVIO_GRATIS ? 0 : ENVIO;
  return {sub, desc, envio, total: base + envio};
}
function renderCarrito(){
  const c = U().carrito;
  document.getElementById("cuerpo-carrito").innerHTML = c.map(i => {
    const p = PRODUCTOS.find(x => x.id === i.id);
    return `<tr id="fila-carrito-${p.id}"><td>${p.emoji} ${p.nombre}</td>
      <td><div class="cantidad"><button id="menos-${p.id}" onclick="cambiarCant(${p.id},-1)">−</button><span id="cant-${p.id}">${i.cant}</span><button id="mas-${p.id}" onclick="cambiarCant(${p.id},1)">+</button></div></td>
      <td>${fmt(p.precio * i.cant)}</td><td><button class="enlace" style="color:var(--err)" id="quitar-${p.id}" onclick="quitar(${p.id})">Quitar</button></td></tr>`;
  }).join("");
  document.getElementById("tabla-carrito").classList.toggle("oculto", c.length === 0);
  document.getElementById("carrito-vacio").classList.toggle("oculto", c.length > 0);
  const t = totales();
  document.getElementById("carrito-subtotal").textContent = fmt(t.sub);
  document.getElementById("carrito-descuento").textContent = "-" + fmt(t.desc) + (cuponActivo ? ` (${cuponActivo})` : "");
  document.getElementById("carrito-envio").textContent = t.envio ? fmt(t.envio) : "Gratis";
  document.getElementById("carrito-total").textContent = fmt(t.total);
  document.getElementById("btn-pagar").disabled = c.length === 0;
}
function cambiarCant(id, d){
  const i = U().carrito.find(x => x.id === id), p = PRODUCTOS.find(x => x.id === id);
  if(i.cant + d > p.stock){ toast(`Solo hay ${p.stock} unidades disponibles`); return; }
  i.cant += d; if(i.cant <= 0) U().carrito = U().carrito.filter(x => x.id !== id);
  persistir(); refrescarUsuario(); renderCarrito();
}
function quitar(id){ U().carrito = U().carrito.filter(x => x.id !== id); if(!U().carrito.length){descuento=0;cuponActivo="";} persistir(); refrescarUsuario(); renderCarrito(); toast("Producto eliminado del carrito"); }
function aplicarCupon(){
  const c = document.getElementById("cupon").value.trim().toUpperCase();
  if(!U().carrito.length) return alerta("alerta-cupon","Agrega productos antes de aplicar un cupón.","error");
  if(!c) return alerta("alerta-cupon","Escribe un código de cupón.","error");
  if(!(c in CUPONES)) return alerta("alerta-cupon","El cupón no es válido o expiró.","error");
  if(cuponActivo === c) return alerta("alerta-cupon","Este cupón ya está aplicado.","error");
  descuento = CUPONES[c]; cuponActivo = c;
  alerta("alerta-cupon",`Cupón ${c} aplicado: ${CUPONES[c]*100}% de descuento.`,"exito"); renderCarrito();
}
function pagar(e){
  e.preventDefault();
  const dir = document.getElementById("envio-direccion").value.trim();
  const ciudad = document.getElementById("envio-ciudad").value;
  if(!U().carrito.length) return alerta("alerta-checkout","Tu carrito está vacío.","error"), false;
  if(dir.length < 8) return alerta("alerta-checkout","Escribe una dirección válida (mínimo 8 caracteres).","error"), false;
  if(!ciudad) return alerta("alerta-checkout","Selecciona una ciudad.","error"), false;
  const pedidos = U().pedidos, num = pedidos.length ? Math.max(...pedidos.map(p => p.num)) + 1 : 5001;
  pedidos.push({num, fecha:new Date().toISOString().slice(0,10), items:U().carrito.map(i => ({...i})), total:totales().total, estado:"Pendiente"});
  U().carrito.forEach(i => { PRODUCTOS.find(p => p.id === i.id).stock -= i.cant; });
  U().carrito = []; descuento = 0; cuponActivo = "";
  persistir(); refrescarUsuario();
  document.getElementById("form-checkout").reset(); document.getElementById("cupon").value = ""; limpiarAlerta("alerta-cupon");
  renderCarrito(); alerta("alerta-checkout",`🎉 ¡Pedido N.º ${num} confirmado! Pago: ${document.querySelector('input[name=pago]:checked')?.value || "Contraentrega"}.`,"exito");
  return false;
}

/* ================= PEDIDOS ================= */
function renderPedidos(){
  const f = document.getElementById("pedidos-filtro").value;
  const l = U().pedidos.filter(p => f === "todos" || p.estado === f).sort((a,b) => b.num - a.num);
  document.getElementById("cuerpo-pedidos").innerHTML = l.map(p => `<tr id="pedido-${p.num}">
    <td>#${p.num}</td><td>${p.fecha}</td><td>${p.items.map(i => PRODUCTOS.find(x => x.id === i.id).emoji + "×" + i.cant).join(" ")}</td>
    <td>${fmt(p.total)}</td><td><span class="estado e-${p.estado}" id="estado-${p.num}">${p.estado}</span></td>
    <td>${p.estado === "Pendiente" ? `<button class="enlace" style="color:var(--err)" id="cancelar-${p.num}" onclick="cancelarPedido(${p.num})">Cancelar</button>` : "—"}</td></tr>`).join("");
  document.getElementById("tabla-pedidos").classList.toggle("oculto", !l.length);
  document.getElementById("pedidos-vacio").classList.toggle("oculto", l.length > 0);
}
function cancelarPedido(n){
  if(!confirm("¿Seguro que deseas cancelar el pedido #" + n + "?")) return;
  U().pedidos.find(p => p.num === n).estado = "Cancelado"; persistir(); renderPedidos(); toast("Pedido #" + n + " cancelado");
}

/* ================= PERFIL ================= */
function renderPerfil(){
  const u = U();
  document.getElementById("perfil-avatar").textContent = u.avatar;
  document.getElementById("perfil-nombre-titulo").textContent = u.nombre;
  document.getElementById("perfil-correo-titulo").textContent = u.correo;
  document.getElementById("perfil-desde").textContent = "Miembro desde " + u.desde;
  document.getElementById("perfil-nombre").value = u.nombre;
  document.getElementById("perfil-correo").value = u.correo;
  document.getElementById("perfil-telefono").value = u.telefono;
  document.getElementById("perfil-nacimiento").value = u.nacimiento;
  document.getElementById("perfil-genero").value = u.genero;
  document.getElementById("perfil-bio").value = u.bio; contarBio();
  document.getElementById("lista-avatares").innerHTML = AVATARES.map((a,i) => `<button id="avatar-${i}" class="${a === u.avatar ? "activa" : ""}" onclick="elegirAvatar('${a}')">${a}</button>`).join("");
  limpiarAlerta("alerta-perfil");
}
function elegirAvatar(a){ U().avatar = a; persistir(); refrescarUsuario(); renderPerfil(); toast("Avatar actualizado " + a); }
function contarBio(){ document.getElementById("bio-contador").textContent = document.getElementById("perfil-bio").value.length; }
function guardarPerfil(e){
  e.preventDefault();
  const nombre = document.getElementById("perfil-nombre").value.trim();
  const tel = document.getElementById("perfil-telefono").value.trim();
  const nac = document.getElementById("perfil-nacimiento").value;
  if(nombre.length < 3 || !/^[a-zA-ZáéíóúÁÉÍÓÚñÑ ]+$/.test(nombre)) return alerta("alerta-perfil","El nombre debe tener al menos 3 letras y sin números.","error"), false;
  if(tel && !/^3\d{9}$/.test(tel)) return alerta("alerta-perfil","El teléfono debe tener 10 dígitos y empezar por 3.","error"), false;
  if(nac){
    const edad = (new Date() - new Date(nac)) / (365.25*24*3600*1000);
    if(edad < 0) return alerta("alerta-perfil","La fecha de nacimiento no puede ser futura.","error"), false;
    if(edad < 18) return alerta("alerta-perfil","Debes ser mayor de 18 años.","error"), false;
  }
  Object.assign(U(), {nombre, telefono:tel, nacimiento:nac, genero:document.getElementById("perfil-genero").value, bio:document.getElementById("perfil-bio").value.trim()});
  persistir(); refrescarUsuario(); renderPerfil();
  alerta("alerta-perfil","✅ Perfil actualizado correctamente.","exito"); return false;
}

/* ================= CONFIGURACIÓN ================= */
function renderConfig(){
  const c = U().config;
  document.getElementById("cfg-oscuro").checked = c.oscuro;
  document.getElementById("cfg-notif-correo").checked = c.notifCorreo;
  document.getElementById("cfg-notif-pedidos").checked = c.notifPedidos;
  document.getElementById("cfg-fuente").value = c.fuente;
  document.getElementById("cfg-idioma").value = c.idioma;
  ["alerta-config","alerta-clave"].forEach(limpiarAlerta);
  document.getElementById("form-clave").reset();
}
function aplicarTema(){ document.body.classList.toggle("oscuro", document.getElementById("cfg-oscuro").checked); }
function aplicarFuente(){ document.body.classList.remove("fuente-grande","fuente-pequena"); const f = document.getElementById("cfg-fuente").value; if(f !== "normal") document.body.classList.add("fuente-" + f); }
function aplicarConfigGuardada(){ const c = U().config; document.body.className = (c.oscuro ? "oscuro " : "") + (c.fuente !== "normal" ? "fuente-" + c.fuente : ""); }
function guardarConfig(){
  U().config = { oscuro:document.getElementById("cfg-oscuro").checked, notifCorreo:document.getElementById("cfg-notif-correo").checked,
    notifPedidos:document.getElementById("cfg-notif-pedidos").checked, fuente:document.getElementById("cfg-fuente").value, idioma:document.getElementById("cfg-idioma").value };
  persistir(); alerta("alerta-config","✅ Preferencias guardadas.","exito");
}
function cambiarClave(e){
  e.preventDefault();
  const a = document.getElementById("clave-actual").value, n = document.getElementById("clave-nueva").value, c = document.getElementById("clave-confirmar").value;
  if(!a || !n || !c) return alerta("alerta-clave","Completa todos los campos.","error"), false;
  if(a !== U().clave) return alerta("alerta-clave","La contraseña actual es incorrecta.","error"), false;
  if(!claveValida(n)) return alerta("alerta-clave","La nueva contraseña debe tener 8+ caracteres, una mayúscula y un número.","error"), false;
  if(n === a) return alerta("alerta-clave","La nueva contraseña debe ser diferente a la actual.","error"), false;
  if(n !== c) return alerta("alerta-clave","Las contraseñas nuevas no coinciden.","error"), false;
  U().clave = n; persistir(); document.getElementById("form-clave").reset();
  alerta("alerta-clave","🔒 Contraseña actualizada correctamente.","exito"); return false;
}
function eliminarCuenta(){
  if(document.getElementById("confirmar-eliminar").value !== "ELIMINAR") return alerta("alerta-eliminar","Debes escribir ELIMINAR en mayúsculas.","error");
  delete usuarios[actual]; persistir();
  document.getElementById("confirmar-eliminar").value = ""; limpiarAlerta("alerta-eliminar"); cerrarModal("modal-eliminar");
  cerrarSesion(); alerta("alerta-login","Tu cuenta fue eliminada.","exito");
}

/* ================= ARRANQUE ================= */
const sesionGuardada = leer("nebula_sesion", null);
if(sesionGuardada && usuarios[sesionGuardada]) entrar(sesionGuardada);
document.addEventListener("keydown", e => { if(e.key === "Escape") document.querySelectorAll(".modal-fondo").forEach(m => m.classList.remove("abierto")); });
</script>
</body>
</html>
