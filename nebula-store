<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nébula Store</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f4f2ff; --card:#ffffff; --texto:#1e1b3a; --suave:#6b6890; --borde:#e3e0f5;
    --p1:#6d28d9; --p2:#db2777; --ok:#16a34a; --err:#dc2626; --warn:#d97706;
    --sombra:0 8px 24px rgba(76,29,149,.10); --radio:16px;
  }
  body.oscuro{ --bg:#14122b; --card:#1e1b3a; --texto:#f1efff; --suave:#a8a4cf; --borde:#2f2b57; --sombra:0 8px 24px rgba(0,0,0,.35); }
  body.fuente-grande{ font-size:17px; } body.fuente-pequena{ font-size:13px; }
  *{box-sizing:border-box}
  body{margin:0;font-family:'Poppins',Arial,sans-serif;background:var(--bg);color:var(--texto);font-size:15px;transition:background .3s}
  button{font-family:inherit;cursor:pointer}
  input,select,textarea{font-family:inherit;width:100%;padding:11px 13px;border:1.5px solid var(--borde);border-radius:10px;background:var(--card);color:var(--texto);font-size:.95em;margin-top:5px}
  input:focus,select:focus,textarea:focus{outline:none;border-color:var(--p1)}
  label{font-weight:500;font-size:.9em;display:block;margin-top:14px}
  .btn{background:linear-gradient(135deg,var(--p1),var(--p2));color:#fff;border:none;padding:11px 20px;border-radius:10px;font-weight:600;font-size:.95em}
  .btn:hover{filter:brightness(1.08)} .btn:disabled{opacity:.5;cursor:not-allowed}
  .btn-sec{background:transparent;border:1.5px solid var(--p1);color:var(--p1);padding:10px 18px;border-radius:10px;font-weight:600}
  .btn-peligro{background:var(--err);color:#fff;border:none;padding:10px 18px;border-radius:10px;font-weight:600}
  .ancho{width:100%;margin-top:20px}
  .alerta{padding:11px 14px;border-radius:10px;margin-top:14px;font-size:.9em;display:none}
  .alerta.error{display:block;background:#fee2e2;color:#991b1b}
  .alerta.exito{display:block;background:#dcfce7;color:#166534}
  .ayuda{color:var(--suave);font-size:.82em;margin-top:4px}
  .oculto{display:none!important}

  /* ===== AUTENTICACIÓN ===== */
  #vista-auth{min-height:100vh;display:grid;grid-template-columns:1fr 1fr}
  .auth-arte{background:linear-gradient(150deg,#4c1d95,#7c3aed 45%,#db2777);color:#fff;padding:48px;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden}
  .auth-arte h1{font-size:2.6em;margin:0 0 10px} .auth-arte p{opacity:.9;max-width:380px}
  .auth-arte svg{position:absolute;right:-60px;bottom:-60px;opacity:.9}
  .flotantes{font-size:2.2em;margin-top:28px;letter-spacing:12px}
  .auth-panel{display:flex;align-items:center;justify-content:center;padding:32px 16px}
  .auth-caja{width:100%;max-width:420px;background:var(--card);padding:32px;border-radius:var(--radio);box-shadow:var(--sombra)}
  .pestanas{display:flex;background:var(--bg);border-radius:12px;padding:4px;margin-bottom:10px}
  .pestanas button{flex:1;border:none;background:transparent;padding:10px;border-radius:9px;font-weight:600;color:var(--suave)}
  .pestanas button.activa{background:var(--card);color:var(--p1);box-shadow:0 2px 8px rgba(0,0,0,.08)}
  .fila-check{display:flex;align-items:center;gap:8px;margin-top:14px;font-size:.9em}
  .fila-check input{width:auto;margin:0}
  .enlace{color:var(--p1);background:none;border:none;font-weight:600;padding:0;font-size:.9em}
  .medidor{height:6px;border-radius:4px;background:var(--borde);margin-top:6px;overflow:hidden}
  .medidor div{height:100%;width:0;transition:.3s}
  .ojo{position:relative} .ojo button{position:absolute;right:10px;top:16px;background:none;border:none;font-size:1.1em}

  /* ===== APP ===== */
  #vista-app{display:flex;min-height:100vh}
  aside{width:240px;background:var(--card);border-right:1px solid var(--borde);padding:22px 14px;display:flex;flex-direction:column;gap:4px;position:sticky;top:0;height:100vh}
  .logo{font-weight:700;font-size:1.3em;padding:0 10px 18px;background:linear-gradient(135deg,var(--p1),var(--p2));-webkit-background-clip:text;color:transparent}
  aside button.menu{display:flex;align-items:center;gap:12px;border:none;background:none;padding:11px 14px;border-radius:10px;text-align:left;color:var(--texto);font-size:.95em;font-weight:500}
  aside button.menu:hover{background:var(--bg)}
  aside button.menu.activa{background:linear-gradient(135deg,var(--p1),var(--p2));color:#fff}
  .insignia{margin-left:auto;background:var(--p2);color:#fff;border-radius:20px;padding:0 8px;font-size:.75em}
  aside .salir{margin-top:auto}
  .contenido{flex:1;padding:24px 28px;min-width:0}
  .barra-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px;flex-wrap:wrap}
  .barra-top h2{margin:0}
  .usuario-chip{display:flex;align-items:center;gap:10px;background:var(--card);padding:6px 14px 6px 6px;border-radius:40px;box-shadow:var(--sombra)}
  .avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--p1),var(--p2));display:flex;align-items:center;justify-content:center;font-size:1.3em}
  .tarjeta{background:var(--card);border-radius:var(--radio);padding:22px;box-shadow:var(--sombra)}
  .pagina{display:none} .pagina.activa{display:block;animation:entra .3s}
  @keyframes entra{from{opacity:0;transform:translateY(8px)}to{opacity:1}}

  .heroe{background:linear-gradient(135deg,var(--p1),var(--p2));color:#fff;border-radius:var(--radio);padding:28px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
  .heroe h3{margin:0 0 6px;font-size:1.5em}
  .heroe .emoji-grande{font-size:4em}
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin:20px 0}
  .stat{background:var(--card);border-radius:var(--radio);padding:18px;box-shadow:var(--sombra)}
  .stat .num{font-size:1.7em;font-weight:700} .stat .lbl{color:var(--suave);font-size:.85em}

  .rejilla{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:16px;margin-top:16px}
  .producto{background:var(--card);border-radius:var(--radio);overflow:hidden;box-shadow:var(--sombra);display:flex;flex-direction:column;transition:transform .2s}
  .producto:hover{transform:translateY(-4px)}
  .producto .img{height:130px;display:flex;align-items:center;justify-content:center;font-size:3.6em;position:relative}
  .producto .fav{position:absolute;top:8px;right:8px;background:rgba(255,255,255,.85);border:none;border-radius:50%;width:34px;height:34px;font-size:1.05em}
  .producto .cuerpo{padding:14px;display:flex;flex-direction:column;gap:4px;flex:1}
  .producto h4{margin:0;font-size:1em}
  .producto .precio{font-weight:700;color:var(--p1);font-size:1.1em}
  .producto .meta{color:var(--suave);font-size:.8em}
  .producto .acciones{display:flex;gap:6px;margin-top:auto;padding-top:8px}
  .producto .acciones button{flex:1;padding:8px;font-size:.82em}
  .agotado{color:var(--err);font-weight:600;font-size:.8em}

  .buscador{display:flex;gap:10px;flex-wrap:wrap}
  .buscador .campo{flex:2;min-width:220px;position:relative}
  .buscador .campo input{padding-left:40px;margin:0}
  .buscador .campo span{position:absolute;left:13px;top:11px}
  .filtros{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-top:14px}
  .filtros label{margin-top:0}
  .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
  .chip{border:1.5px solid var(--borde);background:var(--card);color:var(--texto);border-radius:30px;padding:6px 14px;font-size:.85em}
  .chip.activa{background:var(--p1);color:#fff;border-color:var(--p1)}
  .vacio{text-align:center;padding:40px;color:var(--suave)} .vacio div{font-size:3.5em}

  table{width:100%;border-collapse:collapse}
  th,td{padding:12px;text-align:left;border-bottom:1px solid var(--borde);font-size:.92em}
  th{color:var(--suave);font-weight:500}
  .estado{padding:3px 10px;border-radius:20px;font-size:.8em;font-weight:600}
  .e-Pendiente{background:#fef3c7;color:#92400e} .e-Enviado{background:#dbeafe;color:#1e40af}
  .e-Entregado{background:#dcfce7;color:#166534} .e-Cancelado{background:#fee2e2;color:#991b1b}
  .cantidad{display:flex;align-items:center;gap:6px}
  .cantidad button{width:30px;height:30px;border-radius:8px;border:1.5px solid var(--borde);background:var(--card);color:var(--texto)}

  .dos-col{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .perfil-cab{display:flex;align-items:center;gap:18px;margin-bottom:10px}
  .perfil-cab .avatar{width:80px;height:80px;font-size:2.6em}
  .avatares{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
  .avatares button{font-size:1.5em;border:2px solid var(--borde);background:var(--card);border-radius:12px;width:48px;height:48px}
  .avatares button.activa{border-color:var(--p1);background:var(--bg)}
  .interruptor{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid var(--borde)}
  .interruptor:last-child{border-bottom:none}
  .switch{position:relative;width:48px;height:26px;flex-shrink:0}
  .switch input{opacity:0;width:0;height:0}
  .switch span{position:absolute;inset:0;background:var(--borde);border-radius:30px;transition:.3s;cursor:pointer}
  .switch span:before{content:"";position:absolute;width:20px;height:20px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.3s}
  .switch input:checked+span{background:var(--p1)} .switch input:checked+span:before{transform:translateX(22px)}

  .modal-fondo{position:fixed;inset:0;background:rgba(20,10,50,.55);display:none;align-items:center;justify-content:center;z-index:50;padding:16px}
  .modal-fondo.abierto{display:flex}
  .modal{background:var(--card);border-radius:var(--radio);padding:26px;max-width:460px;width:100%;position:relative}
  .modal .cerrar{position:absolute;top:12px;right:14px;background:none;border:none;font-size:1.4em;color:var(--suave)}
  .modal .img{font-size:5em;text-align:center;border-radius:12px;padding:18px}
  #toast{position:fixed;bottom:22px;right:22px;background:var(--texto);color:var(--card);padding:13px 20px;border-radius:12px;box-shadow:var(--sombra);transform:translateY(120px);transition:.35s;z-index:60;font-size:.92em}
  #toast.visible{transform:none}

  @media (max-width:820px){
    #vista-auth{grid-template-columns:1fr} .auth-arte{padding:30px 20px} .auth-arte svg{display:none}
    #vista-app{flex-direction:column}
    aside{width:100%;height:auto;position:static;flex-direction:row;overflow-x:auto;padding:10px}
    .logo{display:none} aside button.menu{white-space:nowrap} aside .salir{margin-top:0}
    .contenido{padding:16px} .dos-col{grid-template-columns:1fr}
  }
</style>
</head>
<body>

<!-- =================== VISTA DE AUTENTICACIÓN =================== -->
<div id="vista-auth">
  <div class="auth-arte">
    <h1>Nébula Store</h1>
    <p>Tu tienda galáctica de tecnología, hogar, deportes y más. Crea tu cuenta o inicia sesión para empezar a explorar.</p>
    <div class="flotantes">🚀 🎧 🪐 ⚽ 🛋️</div>
    <svg width="380" height="380" viewBox="0 0 200 200"><circle cx="100" cy="100" r="70" fill="#fbbf24" opacity=".85"/><ellipse cx="100" cy="100" rx="98" ry="22" fill="none" stroke="#fff" stroke-width="5" opacity=".7" transform="rotate(-20 100 100)"/><circle cx="78" cy="80" r="10" fill="#f59e0b"/><circle cx="120" cy="118" r="14" fill="#f59e0b"/></svg>
  </div>

  <div class="auth-panel">
    <div class="auth-caja">
      <div class="pestanas">
        <button id="tab-login" class="activa" onclick="pestana('login')">Iniciar sesión</button>
        <button id="tab-registro" onclick="pestana('registro')">Crear cuenta</button>
      </div>

      <!-- LOGIN -->
      <form id="form-login" onsubmit="return iniciarSesion(event)" novalidate>
        <h2 style="margin:14px 0 0">¡Hola de nuevo! 👋</h2>
        <p class="ayuda">Cuenta de prueba: demo@nebula.com / Demo1234</p>
        <label for="login-correo">Correo electrónico</label>
        <input type="email" id="login-correo" name="correo" placeholder="tu@correo.com" autocomplete="off">
        <label for="login-clave">Contraseña</label>
        <div class="ojo">
          <input type="password" id="login-clave" name="clave" placeholder="••••••••">
          <button type="button" id="ver-login-clave" onclick="verClave('login-clave')">👁️</button>
        </div>
        <div class="fila-check" style="justify-content:space-between">
          <span style="display:flex;gap:8px;align-items:center"><input type="checkbox" id="login-recordar"> <label for="login-recordar" style="margin:0;font-weight:400">Recordarme</label></span>
          <button type="button" class="enlace" id="link-olvide" onclick="pestana('recuperar')">¿Olvidaste tu contraseña?</button>
        </div>
        <button type="submit" id="btn-login" class="btn ancho">Iniciar sesión</button>
        <div id="alerta-login" class="alerta"></div>
      </form>

      <!-- REGISTRO -->
      <form id="form-registro" class="oculto" onsubmit="return registrar(event)" novalidate>
        <h2 style="margin:14px 0 0">Crea tu cuenta ✨</h2>
        <label for="reg-nombre">Nombre completo</label>
        <input type="text" id="reg-nombre" placeholder="Ej: Laura Martínez">
        <label for="reg-correo">Correo electrónico</label>
        <input type="email" id="reg-correo" placeholder="tu@correo.com" autocomplete="off">
        <label for="reg-clave">Contraseña</label>
        <div class="ojo">
          <input type="password" id="reg-clave" placeholder="Mínimo 8 caracteres" oninput="medirClave()">
          <button type="button" id="ver-reg-clave" onclick="verClave('reg-clave')">👁️</button>
        </div>
        <div class="medidor"><div id="medidor-barra"></div></div>
        <div class="ayuda" id="medidor-texto">Usa 8+ caracteres, una mayúscula y un número.</div>
        <label for="reg-confirmar">Confirmar contraseña</label>
        <input type="password" id="reg-confirmar" placeholder="Repite la contraseña">
        <label for="reg-pregunta">Pregunta de seguridad: ¿nombre de tu primera mascota?</label>
        <input type="text" id="reg-pregunta" placeholder="Se usa para recuperar tu contraseña">
        <div class="fila-check"><input type="checkbox" id="reg-terminos"><label for="reg-terminos" style="margin:0;font-weight:400">Acepto los términos y condiciones</label></div>
        <button type="submit" id="btn-registro" class="btn ancho">Crear cuenta</button>
        <div id="alerta-registro" class="alerta"></div>
      </form>

      <!-- RECUPERAR -->
      <form id="form-recuperar" class="oculto" onsubmit="return recuperar(event)" novalidate>
        <h2 style="margin:14px 0 0">Recuperar contraseña 🔑</h2>
        <p class="ayuda">Responde tu pregunta de seguridad para crear una contraseña nueva.</p>
        <label for="rec-correo">Correo electrónico</label>
        <input type="email" id="rec-correo" placeholder="tu@correo.com">
        <label for="rec-respuesta">Nombre de tu primera mascota</label>
        <input type="text" id="rec-respuesta">
        <label for="rec-nueva">Nueva contraseña</label>
        <input type="password" id="rec-nueva">
        <button type="submit" id="btn-recuperar" class="btn ancho">Restablecer contraseña</button>
        <button type="button" id="btn-volver-login" class="btn-sec ancho" onclick="pestana('login')">Volver al inicio de sesión</button>
        <div id="alerta-recuperar" class="alerta"></div>
      </form>
    </div>
  </div>
</div>

<!-- =================== VISTA PRINCIPAL =================== -->
<div id="vista-app" class="oculto">
  <aside>
    <div class="logo">🪐 Nébula Store</div>
    <button class="menu activa" id="menu-inicio" onclick="ir('inicio')">🏠 Inicio</button>
    <button class="menu" id="menu-buscar" onclick="ir('buscar')">🔍 Buscar</button>
    <button class="menu" id="menu-favoritos" onclick="ir('favoritos')">❤️ Favoritos <span class="insignia" id="insignia-fav">0</span></button>
    <button class="menu" id="menu-carrito" onclick="ir('carrito')">🛒 Carrito <span class="insignia" id="insignia-carrito">0</span></button>
    <button class="menu" id="menu-pedidos" onclick="ir('pedidos')">📦 Mis pedidos</button>
    <button class="menu" id="menu-perfil" onclick="ir('perfil')">👤 Perfil</button>
    <button class="menu" id="menu-config" onclick="ir('config')">⚙️ Configuración</button>
    <button class="menu salir" id="btn-logout" onclick="cerrarSesion()">🚪 Cerrar sesión</button>
  </aside>

  <div class="contenido">
    <div class="barra-top">
      <h2 id="titulo-pagina">Inicio</h2>
      <div class="usuario-chip"><div class="avatar" id="chip-avatar">🧑‍🚀</div><span id="chip-nombre">Usuario</span></div>
    </div>

    <!-- INICIO -->
    <div class="pagina activa" id="pag-inicio">
      <div class="heroe">
        <div><h3 id="saludo">¡Bienvenido!</h3><p style="margin:0;opacity:.9">Esta semana tenemos el cupón <b>NEBULA10</b> con 10% de descuento.</p>
          <button class="btn-sec" id="btn-ir-buscar" style="background:#fff;border:none;margin-top:14px" onclick="ir('buscar')">Explorar productos →</button></div>
        <div class="emoji-grande">🛸</div>
      </div>
      <div class="stats">
        <div class="stat"><div class="num" id="stat-pedidos">0</div><div class="lbl">Pedidos realizados</div></div>
        <div class="stat"><div class="num" id="stat-favoritos">0</div><div class="lbl">Favoritos</div></div>
        <div class="stat"><div class="num" id="stat-carrito">0</div><div class="lbl">Productos en carrito</div></div>
        <div class="stat"><div class="num" id="stat-gastado">$0</div><div class="lbl">Total gastado</div></div>
      </div>
      <h3>⭐ Recomendados para ti</h3>
      <div class="rejilla" id="rejilla-recomendados"></div>
    </div>

    <!-- BUSCAR -->
    <div class="pagina" id="pag-buscar">
      <div class="tarjeta">
        <div class="buscador">
          <div class="campo"><span>🔍</span><input type="text" id="buscar-texto" placeholder="Buscar productos por nombre o descripción..." onkeyup="if(event.key==='Enter')buscar()"></div>
          <button class="btn" id="btn-buscar" onclick="buscar()">Buscar</button>
          <button class="btn-sec" id="btn-limpiar-filtros" onclick="limpiarFiltros()">Limpiar</button>
        </div>
        <div class="chips" id="chips-categorias"></div>
        <div class="filtros">
          <div><label for="filtro-min">Precio mínimo</label><input type="number" id="filtro-min" placeholder="0" min="0"></div>
          <div><label for="filtro-max">Precio máximo</label><input type="number" id="filtro-max" placeholder="Sin límite" min="0"></div>
          <div><label for="filtro-orden">Ordenar por</label>
            <select id="filtro-orden"><option value="relevancia">Relevancia</option><option value="precio-asc">Precio: menor a mayor</option><option value="precio-desc">Precio: mayor a menor</option><option value="nombre">Nombre A-Z</option><option value="rating">Mejor calificados</option></select></div>
          <div><label for="filtro-rating">Calificación mínima</label>
            <select id="filtro-rating"><option value="0">Cualquiera</option><option value="3">3+ ⭐</option><option value="4">4+ ⭐</option><option value="4.5">4.5+ ⭐</option></select></div>
        </div>
        <div class="fila-check"><input type="checkbox" id="filtro-stock"><label for="filtro-stock" style="margin:0;font-weight:400">Solo productos disponibles</label></div>
        <div id="alerta-buscar" class="alerta"></div>
      </div>
      <p id="contador-resultados" class="ayuda" style="margin-top:16px"></p>
      <div class="rejilla" id="rejilla-resultados"></div>
      <div class="vacio oculto" id="sin-resultados"><div>🔭</div>No encontramos productos con esos filtros.</div>
    </div>

    <!-- FAVORITOS -->
    <div class="pagina" id="pag-favoritos">
      <div class="rejilla" id="rejilla-favoritos"></div>
      <div class="vacio oculto" id="favoritos-vacio"><div>💔</div>Aún no tienes favoritos. Toca el corazón de un producto.</div>
    </div>

    <!-- CARRITO -->
    <div class="pagina" id="pag-carrito">
      <div class="dos-col">
        <div class="tarjeta">
          <h3 style="margin-top:0">Tu carrito</h3>
          <table id="tabla-carrito"><thead><tr><th>Producto</th><th>Cantidad</th><th>Subtotal</th><th></th></tr></thead><tbody id="cuerpo-carrito"></tbody></table>
          <div class="vacio oculto" id="carrito-vacio"><div>🛒</div>Tu carrito está vacío.</div>
          <label for="cupon">Cupón de descuento</label>
          <div style="display:flex;gap:8px"><input type="text" id="cupon" placeholder="Ej: NEBULA10"><button class="btn-sec" id="btn-cupon" style="margin-top:5px" onclick="aplicarCupon()">Aplicar</button></div>
          <div id="alerta-cupon" class="alerta"></div>
